flowchart LR
    subgraph CLIENT["Client (no build step)"]
        direction TB
        WEB["Web pages on one design system<br/>landing · app · library · report · about · privacy · login"]
        PWA["Installable web app<br/>manifest · network-first service worker · offline page"]
        TWA["Android app (Trusted Web Activity)<br/>thin shell, opens the same site full screen"]
        LS[("This device<br/>saved cases · language · theme")]
        WEB --- PWA
        TWA -.opens.-> WEB
        WEB -.-> LS
    end

    subgraph HOST["Vercel"]
        direction TB
        STATIC["Static site<br/>strict CSP · self-hosted scripts and fonts<br/>/.well-known/assetlinks.json · security.txt"]
        VA["Web Analytics<br/>cookie-free page views"]
        PROXY["api/analyze.js<br/>one fixed job: validates, owns the prompt and limits,<br/>same-origin only, daily cap, stores nothing"]
    end

    subgraph AI["Anthropic API"]
        MODEL["Claude + web search<br/>photo check · differential · literature · brief<br/>deletes inputs and outputs within 30 days (their policy)"]
    end

    subgraph CLOUD["Supabase (optional, signed-in only)"]
        AUTH["Auth"]
        DB[("cases table<br/>brief + age, sex, site, duration, skin type<br/>never the photo, never the notes<br/>row level security · delete_my_account()")]
        AUTH --- DB
        USE[("usage_daily<br/>anonymous counts + daily cap<br/>no IDs, no IP, no photo, no text")]
    end

    WEB -->|"photo + case details"| PROXY
    PROXY -->|"x-api-key (server only)"| MODEL
    MODEL -->|"structured JSON"| PROXY
    PROXY --> WEB
    WEB -.->|"Save, if signed in"| DB
    WEB -.->|"Share link: brief in the URL fragment"| WEB
    STATIC --- WEB
    PROXY -.->|"gate + tally (private secret)"| USE
    WEB -.->|"page views (skipped if Do Not Track)"| VA

    classDef live fill:#17181B,stroke:#17181B,color:#fff;
    classDef ext fill:#F4F5F3,stroke:#B9BDC2,color:#4B4F55;
    class WEB,PWA,PROXY,STATIC live;
    class TWA,MODEL,AUTH,DB,LS,USE,VA ext;
